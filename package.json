{
  "name": "@qtmleap/zodios",
  "description": "Typescript API client with autocompletion and zod validations",
  "version": "11.0.0-rc.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/*.types": {
      "types": "./lib/*.types.d.ts",
      "default": "./lib/*.types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "author": {
    "name": "ecyrbe",
    "email": "ecyrbe@gmail.com"
  },
  "homepage": "https://github.com/qtmleap/zodios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qtmleap/zodios.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "fetch",
    "openapi",
    "zod",
    "autocomplete",
    "validation"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "example": "bun examples/jsonplaceholder.ts",
    "example:dev.to": "bun examples/dev.to/example.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --bun biome check",
    "format": "bunx --bun biome check --write",
    "major-rc": "npm version premajor --preid=rc",
    "minor-rc": "npm version preminor --preid=rc",
    "patch-rc": "npm version prepatch --preid=rc",
    "rc": "npm version prerelease --preid=rc",
    "build": "tsdown",
    "check:exports": "publint && attw --pack . --profile esm-only",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.8",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "commitlint": "^21.2.2",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "express": "5.2.1",
    "multer": "2.2.0",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
