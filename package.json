{
  "name": "@zodios/core",
  "description": "Typescript API client with autocompletion and zod validations",
  "version": "11.0.0-rc.0",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./lib/*.types": {
      "import": {
        "types": "./lib/*.types.d.ts",
        "default": "./lib/*.types.js"
      },
      "require": {
        "types": "./lib/*.types.d.cts",
        "default": "./lib/*.types.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "author": {
    "name": "ecyrbe",
    "email": "ecyrbe@gmail.com"
  },
  "homepage": "https://github.com/ecyrbe/zodios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecyrbe/zodios.git"
  },
  "license": "MIT",
  "keywords": [
    "fetch",
    "openapi",
    "zod",
    "autocomplete",
    "validation"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "example": "bun examples/jsonplaceholder.ts",
    "example:dev.to": "bun examples/dev.to/example.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --bun biome check",
    "format": "bunx --bun biome check --write",
    "major-rc": "npm version premajor --preid=rc",
    "minor-rc": "npm version preminor --preid=rc",
    "patch-rc": "npm version prepatch --preid=rc",
    "rc": "npm version prerelease --preid=rc",
    "build": "tsup",
    "check:exports": "publint && attw --pack .",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/express": "4.17.19",
    "@types/multer": "1.4.8",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1.10",
    "commitlint": "^21.2.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "express": "4.18.2",
    "multer": "1.4.5-lts.1",
    "publint": "^0.3.23",
    "tsup": "^8",
    "typescript": "^5.9",
    "vitest": "^4.1.10",
    "zod": "^4"
  }
}
