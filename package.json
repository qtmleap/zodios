{
  "name": "@zodios/core",
  "description": "Typescript API client with autocompletion and zod validations",
  "version": "10.9.6",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./lib/*.types": {
      "import": "./lib/*.types.mjs",
      "require": "./lib/*.types.js",
      "types": "./lib/*.types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "author": {
    "name": "ecyrbe",
    "email": "ecyrbe@gmail.com"
  },
  "homepage": "https://github.com/ecyrbe/zodios",
  "repository": {
    "type": "git",
    "url": "https://github.com/ecyrbe/zodios.git"
  },
  "license": "MIT",
  "keywords": [
    "axios",
    "openapi",
    "zod",
    "autocomplete",
    "validation"
  ],
  "scripts": {
    "prebuild": "rimraf lib",
    "example": "bun examples/jsonplaceholder.ts",
    "example:dev.to": "bun examples/dev.to/example.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bunx --bun biome check",
    "format": "bunx --bun biome check --write",
    "major-rc": "npm version premajor --preid=rc",
    "minor-rc": "npm version preminor --preid=rc",
    "patch-rc": "npm version prepatch --preid=rc",
    "rc": "npm version prerelease --preid=rc",
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "axios": "^0.x || ^1.0.0",
    "zod": "^3.x"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/express": "4.17.19",
    "@types/multer": "1.4.8",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1.10",
    "axios": "1.5.1",
    "commitlint": "^21.2.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "express": "4.18.2",
    "form-data": "4.0.0",
    "multer": "1.4.5-lts.1",
    "rimraf": "5.0.5",
    "tsup": "^8",
    "typescript": "^5.9",
    "vitest": "^4.1.10",
    "zod": "3.22.4"
  }
}
